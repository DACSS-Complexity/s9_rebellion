<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="false">
  <code>breed [citizens citizen]
breed [police officer]

globals [agent-vision effective-legitimacy arrests-this-tick]

citizens-own [hardship grievance risk-aversion perceived-arrest-risk active? release-tick]
patches-own [movement-neighborhood]

to setup
  check-inputs
  clear-all
  set agent-vision vision_in_patches
  set effective-legitimacy legitimacy
  ask patches [ set movement-neighborhood patches in-radius agent-vision ]

  let citizen-count round (0.7 * count patches)
  ask n-of citizen-count patches [
    sprout-citizens 1 [
      set hardship random-float 1
      set risk-aversion random-float 1
      set grievance hardship * (1 - effective-legitimacy)
      set active? false
      set color blue
    ]
  ]
  let police-count round (police-density / 100 * count patches)
  ask n-of police-count patches with [not any? turtles-here] [
    sprout-police 1 
  ]
  update-police-colors
  reset-ticks
end

to go
  if not any? turtles [ stop ]
  set arrests-this-tick 0
  ask citizens with [hidden? and release-tick &lt;= ticks] [ release-citizen ]
  ask turtles with [not hidden?] [
    if not hidden? [
      move-randomly
      ifelse breed = citizens
        [ update-citizen-state ]
        [ arrest-active-citizen ]
    ]
  ]
  set effective-legitimacy max (list 0 (legitimacy - legitimacy-feedback * jailed-share))
  tick
end

to update-citizen-state  ; citizen procedure
  set grievance hardship * (1 - effective-legitimacy)
  let officers-seen count police in-radius agent-vision
  let active-nearby 1 + count ((other citizens in-radius agent-vision) with [active?])
  set perceived-arrest-risk 1 - exp (- risk-sensitivity * floor (officers-seen / active-nearby))
  set active? (grievance - risk-aversion * perceived-arrest-risk) &gt; activation-threshold
  set color ifelse-value active? [red] [blue]
end

to move-randomly
  move-to-vacancy movement-neighborhood
end

to move-to-vacancy [candidate-patches]
  ; Try random patches first. The fallback handles crowded neighborhoods.
  repeat 8 [
    let target one-of candidate-patches
    if not any? [turtles-here with [not hidden?]] of target [
      move-to target
      stop
    ]
  ]
  let target one-of candidate-patches with [not any? turtles-here with [not hidden?]]
  if target != nobody [ move-to target ]
end

to update-police-colors
  ask police [set color yellow]
  
end


to-report percent-active
  if not any? citizens [ report 0 ]
  report 100 * count citizens with [active?] / count citizens
end

to arrest-active-citizen  ; officer procedure
  let suspect one-of (citizens in-radius agent-vision) with [active? and not hidden?]
  if suspect != nobody [
    set arrests-this-tick arrests-this-tick + 1
    ask suspect [
      set active? false
      set color blue
      set release-tick ticks + 1 + random maximum-jail-term
      hide-turtle
    ]
  ]
end

to release-citizen  ; citizen procedure
  if any? other turtles-here with [not hidden?] [
    move-to-vacancy patches
  ]
  show-turtle
end

to-report jailed-share
  if not any? citizens [ report 0 ]
  report count citizens with [hidden?] / count citizens
end

to check-inputs
  if police-density &lt; 1 or police-density &gt; 5 [
    error "Enter a police density from 1 to 5 percent."
  ]
  if legitimacy-feedback &lt; 0 or legitimacy-feedback &gt; 1 [
    error "Enter legitimacy feedback from 0 to 1."
  ]
  if maximum-jail-term &lt; 1 or maximum-jail-term != floor maximum-jail-term [
    error "Enter a positive whole number for maximum-jail-term."
  ]
end</code>
  <widgets>
    <view x="220" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="0" height="404" showTickCounter="true" patchSize="10.0" fontSize="10" wrappingAllowedY="true" width="404" tickCounterLabel="ticks" maxPycor="39" updateMode="1" maxPxcor="39" minPxcor="0"></view>
    <button x="15" y="20" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="95" display="Setup">setup</button>
    <button x="15" y="72" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="95" display="Go">go</button>
    <input x="13" multiline="false" y="129" height="60" variable="vision_in_patches" type="number" width="192">7.0</input>
    <input x="13" y="203" height="60" width="192" variable="legitimacy" type="number" multiline="false">0.82</input>
    <input x="13" y="273" height="60" width="192" variable="activation-threshold" type="number" multiline="false">0.1</input>
    <monitor x="220" y="430" height="61" width="150" precision="1" fontSize="11" display="% active">percent-active</monitor>
    <input x="13" y="343" height="60" width="192" variable="risk-sensitivity" type="number" multiline="false">2.3</input>
    <input x="13" y="413" height="60" width="192" variable="maximum-jail-term" type="number" multiline="false">30.0</input>
    <plot x="220" y="504" width="404" height="200" display="Citizen states" xAxis="Tick" yAxis="Citizens" xMin="0.0" xMax="25.0" yMin="0.0" yMax="1120.0" autoPlotX="true" autoPlotY="false" legend="true">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Quiet" color="-13345367" legend="true">
        <setup></setup>
        <update>plotxy ticks count citizens with [not active? and not hidden?]</update>
      </pen>
      <pen interval="1.0" mode="0" display="Active" color="-2674135" legend="true">
        <setup></setup>
        <update>plotxy ticks count citizens with [active?]</update>
      </pen>
      <pen interval="1.0" mode="0" display="Jailed" color="-7500403" legend="true">
        <setup></setup>
        <update>plotxy ticks count citizens with [hidden?]</update>
      </pen>
    </plot>
    <input x="13" y="483" height="60" width="192" variable="experiment-seed" type="number" multiline="false">1</input>
    <input x="13" y="549" height="60" width="192" variable="police-density" type="number" multiline="false">4</input>
    <input x="13" y="615" height="60" width="192" variable="legitimacy-feedback" type="number" multiline="false">0</input>
    <monitor x="382" y="430" height="61" width="170" precision="3" fontSize="11" display="Effective legitimacy">effective-legitimacy</monitor>
  </widgets>
  <info>## O_mexp · Police density, jail terms, and legitimacy

The **policy-sweep** BehaviorSpace experiment compares vision 1–10, police density 1–5% of patches, maximum jail terms 15, 30, and 60 ticks, and legitimacy feedback λ from 0 to 1 in 0.2 increments. Each setting uses seeds 1, 2, and 3 and records 180 ticks plus Setup. Citizens occupy 70% of patches at Setup. The activation threshold is 0.10 and risk sensitivity is 2.3. The local police-to-active ratio is rounded down in all runs.

The **legitimacy** input is the baseline L₀, set to 0.82 in the experiment. At the end of each tick, effective legitimacy becomes max(0, L₀ − λ × jailed share). Citizens use that value on the next tick. A value of λ = 0 keeps legitimacy fixed. The CSV reports end-of-tick legitimacy, arrests in that tick, and the three citizen counts.

Choose **policy-sweep** in BehaviorSpace and select Table output. The companion notebook detects episodes above 50 active citizens and distinguishes sustained activity from recurring outbursts.</info>
  <turtleShapes>
    <shape name="default" rotatable="true" editableColorIndex="0">
      <polygon color="-1920102913" filled="true" marked="true">
        <point x="150" y="5"></point>
        <point x="40" y="250"></point>
        <point x="150" y="205"></point>
        <point x="260" y="250"></point>
      </polygon>
    </shape>
    <shape name="circle" rotatable="false" editableColorIndex="0">
      <circle x="0" y="0" marked="true" color="-1920102913" diameter="300" filled="true"></circle>
    </shape>
    <shape name="square" rotatable="false" editableColorIndex="0">
      <rectangle endX="270" startY="30" marked="true" color="-1920102913" endY="270" startX="30" filled="true"></rectangle>
    </shape>
  </turtleShapes>
  <linkShapes>
    <shape name="default" curviness="0.0">
      <lines>
        <line x="-0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
        <line x="0.0" visible="true">
          <dash value="1.0"></dash>
          <dash value="0.0"></dash>
        </line>
        <line x="0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
      </lines>
      <indicator>
        <shape name="link direction" rotatable="true" editableColorIndex="0">
          <line endX="90" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
          <line endX="210" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
        </shape>
      </indicator>
    </shape>
  </linkShapes>
  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="policy-sweep" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="180">
      <setup>random-seed experiment-seed
    setup</setup>
      <go>go</go>
      <metrics>
        <metric>ticks</metric>
        <metric>count citizens with [active?]</metric>
        <metric>count citizens with [not active? and not hidden?]</metric>
        <metric>count citizens with [hidden?]</metric>
        <metric>arrests-this-tick</metric>
        <metric>jailed-share</metric>
        <metric>effective-legitimacy</metric>
      </metrics>
      <constants>
        <steppedValueSet variable="vision_in_patches" first="1" step="1" last="10" />
        <enumeratedValueSet variable="experiment-seed">
          <value value="1" />
          <value value="2" />
          <value value="3" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="legitimacy">
          <value value="0.82" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="activation-threshold">
          <value value="0.1" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="risk-sensitivity">
          <value value="2.3" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="police-density">
          <value value="1" />
          <value value="2" />
          <value value="3" />
          <value value="4" />
          <value value="5" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="maximum-jail-term">
          <value value="15" />
          <value value="30" />
          <value value="60" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="legitimacy-feedback">
          <value value="0" />
          <value value="0.2" />
          <value value="0.4" />
          <value value="0.6" />
          <value value="0.8" />
          <value value="1" />
        </enumeratedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
